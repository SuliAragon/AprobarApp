---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StudyQuiz from "../../components/StudyQuiz.astro";
import { simulations, type Simulation } from "../../data/simulations";
import { withBase } from "../../utils/paths";

export function getStaticPaths() {
  return simulations.filter((s) => s.interactiveTest).map((simulation) => ({ params: { slug: simulation.slug }, props: { simulation } }));
}
const { simulation } = Astro.props as { simulation: Simulation };
const test = simulation.interactiveTest;
if (!test) throw new Error(`No existe test interactivo para ${simulation.slug}.`);
const config = {
  key: `aprobarapp:simulacro:${simulation.slug}`, legacyKey: `aprobarapp:simulacro:${simulation.slug}`,
  title: simulation.title, kind: "simulation", href: withBase(`simulacros/${simulation.slug}/`),
  topicCodes: simulation.coveredTopicCodes,
  questions: test.questions.map((q, index) => ({ ...q, displayNumber: Number(q.id.match(/-(\d+)$/)?.[1] ?? index + 1) })),
};
---
<BaseLayout title={`${simulation.title} | AprobarApp`} description={simulation.description}>
  <section class="test-hero">
    <div><p class="eyebrow">Repaso global · {simulation.coveredTopicCodes.length} temas</p><h1>{simulation.title}</h1><p>{simulation.description}</p><p class="study-hint">La corrección conserva la plantilla y la numeración originales del PDF.</p></div>
    <div class="test-hero__actions">
      <a class="button button--secondary" href={withBase("simulacros/")}>Volver a simulacros</a>
      <a class="button button--ghost" href={withBase(simulation.assetPath)} target="_blank" rel="noreferrer">Ver PDF original</a>
    </div>
  </section>
  <StudyQuiz config={config} />
</BaseLayout>
