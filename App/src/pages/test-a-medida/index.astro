---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StudyQuiz from "../../components/StudyQuiz.astro";
import { topics } from "../../data/topics";
import { withBase } from "../../utils/paths";
const practiceTopics = topics.filter((topic) => topic.questionCount > 0);
const blocks = Object.groupBy(practiceTopics, (topic) => topic.blockLabel);
const config = { key: "aprobarapp:custom", title: "Test a medida", kind: "custom", href: withBase("test-a-medida/"), topicCodes: [], questions: [] };
const metadata = JSON.stringify(practiceTopics.map((t) => ({ code: t.code, title: t.shortTitle, count: t.questionCount }))).replace(/</g, "\\u003c");
---
<BaseLayout title="Test a medida | AprobarApp" description="Mezcla temas y prioriza preguntas que todavía no has practicado.">
  <section class="page-hero content-centered custom-test-hero">
    <p class="eyebrow">Repaso personalizado</p><h1>Un test distinto para lo que necesitas hoy</h1>
    <p>Elige temas y tamaño. Priorizamos las preguntas menos practicadas, conservamos tu intento y mostramos también los ejercicios de código.</p>
  </section>
  <section class="custom-test-builder" data-custom-test-builder>
    <script type="application/json" data-custom-topic-metadata set:html={metadata} />
    <div class="custom-test-builder__header"><div><p class="eyebrow">Configuración</p><h2>Prepara tu repaso</h2></div><p data-custom-selection-summary></p></div>
    <div class="custom-test-builder__controls">
      <fieldset class="custom-test-builder__topics">
        <legend>Temas incluidos</legend>
        <div class="custom-test-builder__quick-actions"><button class="text-link" type="button" data-select-all>Seleccionar todos</button><button class="text-link" type="button" data-clear-selection>Limpiar</button></div>
        <div class="custom-topic-picker">
          {Object.entries(blocks).map(([label, blockTopics]) => <div class="custom-topic-picker__block"><p>{label}</p><div class="custom-topic-picker__list">{blockTopics!.map((topic) => <label class="custom-topic-option"><input type="checkbox" value={topic.code} data-custom-topic /><span class="custom-topic-option__check" aria-hidden="true"></span><span class="custom-topic-option__content"><strong>{topic.code}</strong><span>{topic.shortTitle}</span></span><small>{topic.questionCount} preguntas únicas</small></label>)}</div></div>)}
        </div>
      </fieldset>
      <div class="custom-test-builder__settings">
        <label class="custom-test-builder__size" for="custom-test-size"><span>Preguntas del test</span><select id="custom-test-size" data-custom-size><option value="20">20 preguntas</option><option value="30">30 preguntas</option><option value="50" selected>50 preguntas</option><option value="100">100 preguntas</option></select></label>
        <label class="study-check"><input type="checkbox" data-custom-unseen /> Solo preguntas que aún no he respondido</label>
        <p class="custom-test-builder__note">El reparto entre temas se equilibra. Si el banco no alcanza el tamaño pedido, el test tendrá menos preguntas: nunca se repite una dentro del mismo intento.</p>
        <button class="button button--primary" type="button" data-generate-custom-test>Preparar preguntas</button>
        <p class="custom-test-builder__error" data-custom-error role="alert" hidden></p>
      </div>
    </div>
  </section>
  <StudyQuiz config={config} />
  <script>
    import { mountCustomBuilder } from "../../lib/custom-builder-client.mjs";
    mountCustomBuilder(document.querySelector("[data-custom-test-builder]"));
  </script>
</BaseLayout>
