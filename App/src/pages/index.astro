---
import BaseLayout from "../layouts/BaseLayout.astro";
import StudyDashboard from "../components/StudyDashboard.astro";
import TopicCard from "../components/TopicCard.astro";
import Icon from "../components/Icon.astro";
import { simulations } from "../data/simulations";
import { topics } from "../data/topics";
import { withBase } from "../utils/paths";

const featuredTopics = topics.slice(0, 3);
const latestSimulation = simulations.at(-1);
---

<BaseLayout title="AprobarApp | TAI 2027" description="Temarios TAI con tests tipo autoescuela en Astro.">
  <StudyDashboard />

  <section class="workspace-shortcuts" aria-label="Elige tu siguiente sesión">
    <a href={withBase("temarios/")}><span class="workspace-shortcut__icon"><Icon name="book" size={23} /></span><div><small>01 / Aprende</small><h2>Abre un tema</h2><p>PDF, esquemas y material de apoyo.</p></div><Icon name="arrow" size={20} /></a>
    <a href={withBase("test-a-medida/")}><span class="workspace-shortcut__icon"><Icon name="sliders" size={23} /></span><div><small>02 / Practica</small><h2>A tu medida</h2><p>Combina los temas que necesitas.</p></div><Icon name="arrow" size={20} /></a>
    <a href={withBase("cuaderno/")}><span class="workspace-shortcut__icon"><Icon name="notebook" size={23} /></span><div><small>03 / Consolida</small><h2>Vuelve a tus dudas</h2><p>Convierte tus errores en aprendizaje.</p></div><Icon name="arrow" size={20} /></a>
  </section>

  <section class="section-block section-block--centered">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Tu biblioteca</p>
        <h2>El conocimiento, en orden.</h2>
        <p>{topics.length} temas disponibles para avanzar a tu ritmo.</p>
      </div>
      <a class="text-link" href={withBase("temarios/")}>Ver todos</a>
    </div>

    <div class="topic-grid topic-grid--centered">
      {featuredTopics.map((topic) => <TopicCard topic={topic} />)}
    </div>
  </section>

  {
    latestSimulation && (
      <section class="section-block section-block--centered">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Repaso acumulado</p>
            <h2>Simulacros globales ya disponibles</h2>
          </div>
          <a class="text-link" href={withBase("simulacros/")}>Ver simulacros</a>
        </div>

        <article class="official-material official-material--simulation">
          <div class="official-material__main">
            <div class="official-material__header">
              <span class="official-material__badge">Simulacro</span>
              <span class="official-material__filename">{latestSimulation.sourceFilename}</span>
            </div>
            <p class="official-material__context">{latestSimulation.studyLabel}</p>
            <h3>{latestSimulation.title}</h3>
            <p>{latestSimulation.description}</p>
          </div>

          <div class="official-material__footer">
            <div class="test-card__meta official-material__meta">
              <span>{latestSimulation.coveredTopicCodes.length} temas</span>
              <span>PDF de repaso</span>
            </div>

            <div class="official-material__actions">
              <a class="button button--primary" href={withBase("simulacros/")}>
                Abrir sección
              </a>
            </div>
          </div>
        </article>
      </section>
    )
  }

  <section class="section-block section-block--alt section-block--centered" id="como-funciona">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Flujo de estudio</p>
        <h2>Un método sencillo. Tu propio ritmo.</h2>
      </div>
    </div>

    <div class="study-steps study-steps--centered">
      <article>
        <span>01</span>
        <h3>Entiende</h3>
        <p>Empieza por el temario y sus esquemas. Haz sitio a las ideas antes de memorizarlas.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Practica</h3>
        <p>Comprueba lo aprendido con tests por tema, preguntas a medida y ejercicios de código.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Ponte a prueba</h3>
        <p>Elige el modo examen cuando quieras practicar con tiempo y corregir al terminar.</p>
      </article>
      <article>
        <span>04</span>
        <h3>Vuelve mejor</h3>
        <p>Tu cuaderno reúne fallos, blancos y dudas. El progreso te ayuda a decidir el siguiente paso.</p>
      </article>
    </div>
  </section>
</BaseLayout>
