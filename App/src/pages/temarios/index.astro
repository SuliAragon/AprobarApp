---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopicCard from "../../components/TopicCard.astro";
import { topicNavigator, topics } from "../../data/topics";

const firstAvailableBlock = topicNavigator.blockOptions.find((block) => block.loadedTopicCount > 0)?.value ?? "1";
const firstAvailableTheme = topicNavigator.themeOptionsByBlock[firstAvailableBlock]?.[0]?.value ?? "";
---

<BaseLayout title="Temarios | AprobarApp" description="Listado de temarios y tests específicos para TAI 2027.">
  <section class="page-hero content-centered">
    <p class="eyebrow">Biblioteca de estudio</p>
    <h1>Tu biblioteca de estudio.</h1>
    <p>
      Cada tema en su sitio. Encuentra tus PDF, esquemas, audios y tests por bloque y número.
    </p>
  </section>

  <section class="section-block section-block--centered">
    <div class="topic-picker" data-topic-picker-root>
      <div class="topic-picker__intro">
        <p class="eyebrow">Encuentra tu siguiente tema</p>
        <h2>¿Por dónde seguimos?</h2>
        <p>
          Selecciona un bloque y un tema para ver todo su material disponible.
        </p>
      </div>

      <div class="topic-picker__controls">
        <label class="topic-picker__field">
          <span>Bloque</span>
          <select data-block-select>
            {
              topicNavigator.blockOptions.map((block) => (
                <option value={block.value} selected={block.value === firstAvailableBlock}>
                  {block.label} · {block.loadedTopicCount} cargados
                </option>
              ))
            }
          </select>
        </label>

        <label class="topic-picker__field">
          <span>Tema</span>
          <select data-theme-select data-initial-theme={firstAvailableTheme}></select>
        </label>
      </div>

      <p class="topic-picker__hint" data-topic-picker-hint>
        Mostrando el primer tema disponible del bloque seleccionado.
      </p>

      <div class="topic-grid topic-grid--centered topic-grid--picker" data-topic-results>
        {
          topics.map((topic) => (
            <div
              data-topic-entry
              data-block={topic.blockNumber ?? ""}
              data-topic={topic.topicNumber ?? ""}
              data-slug={topic.slug}
              hidden
            >
              <TopicCard topic={topic} />
            </div>
          ))
        }
      </div>

      <article class="empty-state" data-topic-empty hidden>
        <h3>No hay ningún tema cargado en esa combinación todavía</h3>
        <p>
          Cuando metas más PDFs del bloque o del tema correspondiente, aparecerán aquí automáticamente sin tocar la
          estructura de la página.
        </p>
      </article>
    </div>
  </section>

  <script
    is:inline
    define:vars={{
      firstAvailableBlock,
      firstAvailableTheme,
      themeOptionsByBlock: topicNavigator.themeOptionsByBlock,
    }}
  >
    const topicPickerRoot = document.querySelector("[data-topic-picker-root]");

    if (topicPickerRoot) {
      const blockSelect = topicPickerRoot.querySelector("[data-block-select]");
      const themeSelect = topicPickerRoot.querySelector("[data-theme-select]");
      const topicEntries = [...topicPickerRoot.querySelectorAll("[data-topic-entry]")];
      const emptyState = topicPickerRoot.querySelector("[data-topic-empty]");
      const hintNode = topicPickerRoot.querySelector("[data-topic-picker-hint]");

      const fillThemeOptions = (blockValue, preferredTheme = "") => {
        if (!themeSelect) {
          return "";
        }

        const options = themeOptionsByBlock[blockValue] ?? [];
        themeSelect.innerHTML = "";

        if (options.length === 0) {
          const emptyOption = document.createElement("option");
          emptyOption.value = "";
          emptyOption.textContent = "No hay temas cargados";
          themeSelect.append(emptyOption);
          themeSelect.disabled = true;
          return "";
        }

        for (const option of options) {
          const element = document.createElement("option");
          element.value = option.value;
          element.textContent = option.label;
          themeSelect.append(element);
        }

        themeSelect.disabled = false;

        const nextTheme = options.some((option) => option.value === preferredTheme) ? preferredTheme : options[0].value;
        themeSelect.value = nextTheme;
        return nextTheme;
      };

      const syncVisibleTopic = () => {
        if (!blockSelect || !themeSelect || !emptyState || !hintNode) {
          return;
        }

        const blockValue = blockSelect.value;
        const themeValue = themeSelect.value;
        let visibleCount = 0;

        for (const entry of topicEntries) {
          const isVisible =
            entry.getAttribute("data-block") === blockValue && entry.getAttribute("data-topic") === themeValue;
          entry.hidden = !isVisible;
          visibleCount += isVisible ? 1 : 0;
        }

        emptyState.hidden = visibleCount !== 0;

        if (visibleCount === 0) {
          hintNode.textContent = `No hay tema cargado para el bloque ${blockValue} con ese número todavía.`;
          return;
        }

        const currentOption = themeSelect.selectedOptions[0];
        hintNode.textContent = `${blockSelect.selectedOptions[0]?.textContent ?? `Bloque ${blockValue}`} · ${currentOption?.textContent ?? `Tema ${themeValue}`}`;
      };

      const initialTheme = fillThemeOptions(firstAvailableBlock, firstAvailableTheme);
      if (themeSelect) {
        themeSelect.value = initialTheme;
      }
      syncVisibleTopic();

      blockSelect?.addEventListener("change", () => {
        const nextTheme = fillThemeOptions(blockSelect.value, "");
        if (themeSelect) {
          themeSelect.value = nextTheme;
        }
        syncVisibleTopic();
      });

      themeSelect?.addEventListener("change", syncVisibleTopic);
    }
  </script>
</BaseLayout>
