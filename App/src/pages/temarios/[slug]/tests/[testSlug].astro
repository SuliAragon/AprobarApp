---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import StudyQuiz from "../../../../components/StudyQuiz.astro";
import { topics, type Topic } from "../../../../data/topics";
import { questionBanksByCode } from "../../../../data/question-banks";
import type { TopicTest } from "../../../../data/question-bank";
import { withBase } from "../../../../utils/paths";

export async function getStaticPaths() {
  return topics.flatMap((topic) => topic.tests.map((test) => ({ params: { slug: topic.slug, testSlug: test.slug }, props: { topic, test } })));
}
const { topic, test } = Astro.props as { topic: Topic; test: TopicTest };
const group = topic.practiceGroups.find((group) => group.tests.some((item) => item.slug === test.slug));
const storageKey = `aprobarapp:test:${topic.slug}:${test.slug}`;
const bank = questionBanksByCode[topic.code] ?? [];
const pool = group ? bank.filter((q) => q.section.startsWith(`${group.slug}-`)) : bank;
const config = {
  key: storageKey, legacyKey: storageKey, title: `${topic.code} · ${test.title}`, kind: "practice",
  href: withBase(`temarios/${topic.slug}/tests/${test.slug}/`), topicCodes: [topic.code],
  questions: test.questions.map((q) => ({ ...q, topicCode: topic.code })), pool, focusSections: test.focusSections,
};
---
<BaseLayout title={`${test.title} | AprobarApp`} description={test.description}>
  <section class="test-hero">
    <div><p class="eyebrow">{topic.code} · {topic.shortTitle}</p><h1>{test.title}</h1><p>{test.description}</p></div>
    <div class="test-hero__actions">
      <a class="button button--secondary" href={withBase(`temarios/${topic.slug}/`)}>Volver al tema</a>
      <a class="button button--ghost" href={withBase(group?.documentPath ?? topic.pdfAssetPath)}>Ver PDF</a>
    </div>
  </section>
  <StudyQuiz config={config} />
</BaseLayout>
