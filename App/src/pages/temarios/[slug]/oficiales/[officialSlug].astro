---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import StudyQuiz from "../../../../components/StudyQuiz.astro";
import { topics, type OfficialMaterial, type Topic } from "../../../../data/topics";
import { withBase } from "../../../../utils/paths";
import { prepareOfficialQuestions } from "../../../../lib/official-question-identity.mjs";

export async function getStaticPaths() {
  return topics.flatMap((topic) => topic.officialMaterials.filter((m) => m.hasInteractiveQuiz && m.interactiveTest).map((material) => ({
    params: { slug: topic.slug, officialSlug: material.slug }, props: { topic, material },
  })));
}
const { topic, material } = Astro.props as { topic: Topic; material: OfficialMaterial };
const test = material.interactiveTest;
if (!test) throw new Error(`No existe test interactivo para ${material.slug}.`);
const storageKey = `aprobarapp:official:${topic.slug}:${material.slug}`;
const config = {
  key: storageKey, legacyKey: storageKey, title: `${topic.code} · ${material.title}`, kind: "official",
  href: withBase(`temarios/${topic.slug}/oficiales/${material.slug}/`), topicCodes: [topic.code],
  questions: prepareOfficialQuestions(test.questions, topic.code),
};
---
<BaseLayout title={`${material.title} | AprobarApp`} description={test.description}>
  <section class="test-hero">
    <div><p class="eyebrow">{topic.code} · {topic.shortTitle}</p><h1>{material.title}</h1><p>{test.description}</p><p class="study-hint">Plantilla oficial: se conservan la numeración, el texto, el orden y las letras originales.</p></div>
    <div class="test-hero__actions">
      <a class="button button--secondary" href={withBase(`temarios/${topic.slug}/#oficiales`)}>Volver al tema</a>
      <a class="button button--ghost" href={withBase(material.assetPath)} target="_blank" rel="noreferrer">Ver archivo oficial</a>
    </div>
  </section>
  <StudyQuiz config={config} />
</BaseLayout>
