---
import Header from "../components/Header.astro";
import Icon from "../components/Icon.astro";
import { getWorkspaceContext } from "../lib/workspace-navigation.mjs";
import { withBase } from "../utils/paths";
import "../styles/global.css";
import "../styles/redesign.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "AprobarApp para estudiar temarios TAI con tests tipo autoescuela." } = Astro.props;
const context = getWorkspaceContext(Astro.url.pathname, import.meta.env.BASE_URL);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f2eb" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <script is:inline>
      (() => {
        const storageKey = "aprobarapp:theme";
        let theme = "light";

        try {
          const stored = window.localStorage.getItem(storageKey);
          if (stored === "light" || stored === "dark") {
            theme = stored;
          } else if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            theme = "dark";
          }
        } catch {
          if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
            theme = "dark";
          }
        }

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class={`page-context--${context.kind}`}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="app-shell">
      <Header />
      <div class="workspace-body">
        <div class="workspace-topbar">
          <p><span>Mi espacio</span><span aria-hidden="true">/</span><strong>{context.label}</strong></p>
          <time data-workspace-date></time>
        </div>
        <main class="page-content" id="contenido" tabindex="-1"><slot /></main>
        <footer class="workspace-footer"><span>AprobarApp <span aria-hidden="true">·</span> TAI 2027</span><a href={withBase("progreso/#copia-seguridad")}><Icon name="shield" size={15} />Datos locales. Estudio personal.</a></footer>
      </div>
    </div>
  </body>
</html>
