---
import { withBase } from "../utils/paths";
import { getWorkspaceContext, workspaceLinks } from "../lib/workspace-navigation.mjs";
import Icon from "./Icon.astro";
const context = getWorkspaceContext(Astro.url.pathname, import.meta.env.BASE_URL);
---
<header class="workspace-sidebar" data-workspace-header>
  <a class="workspace-brand" href={withBase("")} aria-label="AprobarApp · Inicio">
    <span class="workspace-brand__mark" aria-hidden="true">a<span>.</span></span>
    <span><strong>AprobarApp</strong><small>Tu camino a TAI 2027</small></span>
  </a>
  <button class="workspace-menu-button" type="button" aria-controls="workspace-navigation" aria-expanded="false" data-menu-toggle hidden><Icon name="menu" /><span data-menu-label>Menú</span></button>
  <div class="workspace-navigation" id="workspace-navigation">
    <nav aria-label="Navegación principal">
      {["Estudio", "Organización"].map((group) => (
        <div class="workspace-nav-group">
          <p>{group}</p>
          {workspaceLinks.filter((link) => link.group === group).map((link) => (
            <a class:list={["workspace-nav-link", context.active === link.id && "is-active"]} href={withBase(link.path)} aria-current={context.active === link.id ? "page" : undefined}>
              <Icon name={link.icon} /><span>{link.label}</span>{context.active === link.id && <span class="workspace-nav-link__dot" aria-hidden="true"></span>}
            </a>
          ))}
        </div>
      ))}
    </nav>
    <div class="workspace-sidebar__bottom">
      <a class="workspace-local-note" href={withBase("progreso/#copia-seguridad")}><Icon name="shield" size={18} /><span>Tu progreso, contigo<small>Guardado en este navegador</small></span></a>
      <div class="theme-toggle" aria-label="Cambiar tema">
        <button class="theme-toggle__button" type="button" data-theme-option="light"><Icon name="sun" size={16} />Claro</button>
        <button class="theme-toggle__button" type="button" data-theme-option="dark"><Icon name="moon" size={16} />Oscuro</button>
      </div>
      <p class="workspace-edition">Constancia antes que prisa.</p>
    </div>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>("[data-workspace-header]");
  const menu = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menuLabel = document.querySelector("[data-menu-label]");
  const meta = document.querySelector('meta[name="theme-color"]');
  const syncTheme = () => {
    const theme = document.documentElement.dataset.theme || "light";
    for (const button of document.querySelectorAll("[data-theme-option]")) {
      const active = button.getAttribute("data-theme-option") === theme;
      button.classList.toggle("is-active", active);
      button.setAttribute("aria-pressed", String(active));
    }
    meta?.setAttribute("content", getComputedStyle(document.documentElement).getPropertyValue("--bg").trim());
  };
  syncTheme();
  document.addEventListener("click", (event) => {
    const button = event.target instanceof Element ? event.target.closest("[data-theme-option]") : null;
    const theme = button?.getAttribute("data-theme-option");
    if (theme !== "light" && theme !== "dark") return;
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    try { localStorage.setItem("aprobarapp:theme", theme); } catch {}
    syncTheme();
  });
  if (header && menu) {
    header.classList.add("is-enhanced");
    menu.hidden = false;
    const setOpen = (open: boolean) => {
      header.classList.toggle("is-menu-open", open);
      menu.setAttribute("aria-expanded", String(open));
      if (menuLabel) menuLabel.textContent = open ? "Cerrar" : "Menú";
    };
    menu.addEventListener("click", () => setOpen(menu.getAttribute("aria-expanded") !== "true"));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.getAttribute("aria-expanded") === "true") { setOpen(false); menu.focus(); }
    });
    header.querySelector("nav")?.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a") && matchMedia("(max-width: 1024px)").matches) setOpen(false);
    });
  }
  const topbar = document.querySelector(".workspace-topbar");
  const measureHeader = () => {
    const visibleHeader = matchMedia("(max-width: 1024px)").matches ? header : topbar;
    const height = visibleHeader?.getBoundingClientRect().height ?? 0;
    document.documentElement.style.setProperty("--header-height", String(height) + "px");
  };
  measureHeader();
  if ("ResizeObserver" in window) {
    const observer = new ResizeObserver(measureHeader);
    if (header) observer.observe(header);
    if (topbar) observer.observe(topbar);
  }
  window.addEventListener("resize", measureHeader);
  const date = document.querySelector("[data-workspace-date]");
  if (date) date.textContent = new Intl.DateTimeFormat("es-ES", { weekday: "long", day: "numeric", month: "long" }).format(new Date());
</script>
