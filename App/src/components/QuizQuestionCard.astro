---
import type { QuizQuestion } from "../data/question-bank";

interface Props {
  index: number;
  displayNumber?: number;
  question: QuizQuestion;
}

const { index, displayNumber, question } = Astro.props;
---

<article class="quiz-question" data-question data-correct={question.correctOption}>
  <div class="quiz-question__header">
    <span class="quiz-question__index">Pregunta {displayNumber ?? index + 1}</span>
    <span class="quiz-question__section">{question.section.replace(/-/g, " ")}</span>
  </div>

  <h3>{question.prompt}</h3>
  {question.code && <div class="quiz-code"><span>{question.codeLanguage ?? "Código"}</span><pre><code>{question.code}</code></pre></div>}

  <div class="quiz-options">
    {
      question.options.map((option) => (
        <button class="quiz-option" type="button" data-option={option.id}>
          <span class="quiz-option__letter">{option.id.toUpperCase()}</span>
          <span>{option.label}</span>
        </button>
      ))
    }
  </div>

  <div class="quiz-feedback" data-feedback hidden>
    <p class="quiz-feedback__title" data-feedback-title></p>
    <p class="quiz-feedback__body">{question.explanation}</p>
  </div>
</article>

<style>
  .quiz-code { margin: 1rem 0; padding: 1rem; min-width: 0; border: 1px solid var(--line, #9aa9ba); border-radius: 0.5rem; }
  .quiz-code > span { font-size: 0.8rem; font-weight: 700; }
  .quiz-code pre { margin-bottom: 0; overflow-x: auto; white-space: pre; tab-size: 2; }
  .quiz-code code { font-family: "SFMono-Regular", Consolas, monospace; font-size: 0.95rem; }
</style>
